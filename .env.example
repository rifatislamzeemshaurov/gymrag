# =============================================================================
# GymRAG - environment configuration
# =============================================================================
# One file configures everything. Read by:
#   - backend/            local runs of the API
#   - ingestion/          rag_pipeline.ipynb (loads the catalog into Qdrant)
#   - scripts/deploy.*    and scripts/destroy.*
#
# Copy this file to .env and fill it in. Never commit .env (it's gitignored).
# Format: plain KEY=value, no quotes, no spaces around "=".
# =============================================================================

# --- AWS account -------------------------------------------------------------
# Credentials the deploy/destroy scripts use. Leave both keys empty to use
# your "aws configure" profile instead.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
# Optional safety check: deploys abort if the credentials belong to another
# account.
AWS_ACCOUNT_ID=

# --- Project -----------------------------------------------------------------
# Name prefix for every AWS resource: <PROJECT_NAME>-<environment>-*
# Lowercase letters, numbers and hyphens only.
PROJECT_NAME=gymrag

# --- Custom domain -----------------------------------------------------------
# Easiest: pass the domain once to the deploy script and it fills these in:
#   ./scripts/deploy.sh prod gym.example.com
# DOMAIN_NAME must be a public hosted zone in Route 53. APP_SUBDOMAIN empty =
# serve on the apex domain itself.
USE_CUSTOM_DOMAIN=false
DOMAIN_NAME=example.com
APP_SUBDOMAIN=gym

# --- Backend compute (ECS Fargate) -------------------------------------------
# CONTAINER_CPU in CPU units (512 = 0.5 vCPU), CONTAINER_MEMORY in MiB.
CONTAINER_CPU=512
CONTAINER_MEMORY=1024
DESIRED_COUNT=1

# --- OpenAI ------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# --- Qdrant ------------------------------------------------------------------
# Qdrant Cloud cluster holding the "gymrag-supplements-openai-qdrant"
# collection. For local development you can run Qdrant in Docker instead:
#   docker run -d -p 6333:6333 qdrant/qdrant   ->   QDRANT_URL=http://localhost:6333
QDRANT_URL=
QDRANT_API_KEY=

# --- API access --------------------------------------------------------------
# Shared secret the frontend sends as the X-API-Key header. Any long random
# string. Must match NEXT_PUBLIC_API_KEY in frontend/.env.development.
API_KEY_UI=
# Allowed browser origins for local runs (comma-separated). Set automatically
# in AWS.
CORS_ORIGINS=http://localhost:3000

# --- Conversation memory (local runs) ----------------------------------------
# In AWS, USE_S3 and S3_BUCKET are set automatically by Terraform.
USE_S3=false
S3_BUCKET=
MEMORY_DIR=../memory
